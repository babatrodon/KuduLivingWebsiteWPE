---
/* Homepage — hero carousel, product inspirations, collections, bespoke, contract, newsletter. */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { featuredProductUrl, img } from "../lib/content";

// Hero slides: image, eyebrow, title, CTA label, CTA url.
const slides = [
  { img: "hero/tufty-time.jpg", eyebrow: "Signature Collection", title: "The Savanna Kitchen", cta: "Discover the piece", href: featuredProductUrl },
  { img: "hero/salone-marble.jpg", eyebrow: "Rooted in Nature", title: "Furniture that becomes the feeling of home.", cta: "Explore Collections", href: "/collections/" },
  { img: "hero/homepage-1.jpg", eyebrow: "New This Season", title: "Wood becomes atmosphere.", cta: "View the collection", href: "/collections/" },
  { img: "hero/cortina.jpg", eyebrow: "Bespoke & Contract", title: "Interiors crafted to last.", cta: "Start a project", href: "/contract/" },
  { img: "hero/salone-26.jpg", eyebrow: "The Studio", title: "Meet the hands behind the wood.", cta: "Our story", href: "/about/" },
];

// Inspiration scenes: image + hotspots [x%, y%, name, category, product image].
type Spot = [number, number, string, string, string];
const scenes: { img: string; spots: Spot[] }[] = [
  { img: "inspirations/scene-01.jpg", spots: [
    [34, 62, "Kalahari Sofa", "Sofas", "products/bebitalia_sofa_Tufty-Time_20_05.jpg"],
    [60, 70, "Marula Side Table", "Small Tables", "products/bebitalia_small-table_Surface_01.jpg"],
    [15, 55, "Nyala Lounge Chair", "Chairs", "products/bebitalia_armchair_Grande-Papilio_01.jpg"],
  ] },
  { img: "inspirations/scene-02.jpg", spots: [
    [40, 60, "Acacia Dining Table", "Tables", "products/bebitalia_table_Alex_01_7.jpg"],
    [62, 64, "Karoo Chair", "Chairs", "products/bebitalia_chair_Jens_01.jpg"],
    [80, 58, "Baobab Console", "Storage", "products/bebitalia_wallsystem_Jack_01.jpg"],
  ] },
  { img: "inspirations/scene-03.jpg", spots: [
    [33, 60, "Savanna Sofa", "Sofas", "products/bebitalia_sofa_Charles-Large_01.jpg"],
    [55, 66, "Thorn Coffee Table", "Small Tables", "products/bebitalia_small-table_Diesis_01.jpg"],
    [74, 62, "Aloe Side Table", "Small Tables", "products/bebitalia_small-table_Frank_01.jpg"],
  ] },
  { img: "inspirations/scene-04.jpg", spots: [
    [36, 62, "Spool Side Table", "Small Tables", "products/bebitalia_small-table_Spool_01.jpg"],
    [58, 58, "Metropolitan Chair", "Chairs", "products/bebitalia_armchair_Metropolitan_Relax_05.jpg"],
    [78, 64, "Cozy Table", "Small Tables", "products/bebitalia_small-table_Cozy_01.jpg"],
  ] },
  { img: "inspirations/scene-05.jpg", spots: [
    [35, 60, "Charles Sofa", "Sofas", "products/bebitalia_sofa_Charles_01.jpg"],
    [60, 64, "Harbor Chair", "Chairs", "products/bebitalia_armchair_Harbor_01.jpg"],
  ] },
];

const tiles = [
  { label: "Indoor", img: "categories/indoor.jpg", cta: "Discover indoor" },
  { label: "Outdoor", img: "categories/outdoor.jpg", cta: "Discover outdoor" },
];
---
<Base>
<main>

<!-- HERO CAROUSEL -->
<section data-kudu-carousel class="relative h-[70vh] min-h-[480px] w-full overflow-hidden bg-kudu-navy md:h-[771px]">
  {slides.map((s) => (
    <div data-slide class="absolute inset-0 bg-cover bg-center opacity-0 transition-opacity duration-700" style={`background-image:url('${img(s.img)}')`}>
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></div>
      <div class="absolute bottom-[90px] left-0 w-full md:bottom-[130px]">
        <div class="mx-auto w-full max-w-[1440px] px-5 md:px-[68px]">
          <p class="mb-3 text-[12px] font-bold uppercase tracking-[0.18em] text-kudu-teal">{s.eyebrow}</p>
          <h2 class="max-w-[18ch] font-serif text-[34px] leading-[1.05] text-white md:text-[56px]">{s.title}</h2>
          <a href={s.href} class="mt-7 inline-flex h-[50px] items-center rounded-none bg-kudu-teal px-9 text-[12px] font-bold uppercase tracking-[1px] text-kudu-navy transition-colors hover:bg-white">{s.cta}</a>
        </div>
      </div>
    </div>
  ))}
  <div class="absolute bottom-[46px] left-0 z-20 w-full">
    <div class="mx-auto flex w-full max-w-[1440px] gap-3 px-5 md:px-[68px]">
      {slides.map((_, i) => (
        <button data-dot type="button" class="-m-[18px] box-content h-2 w-2 rounded-full bg-white/50 bg-clip-content p-[18px] transition-colors" aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<!-- NEWSLETTER STRIP -->
<a href="/contact/" class="flex h-[60px] items-center justify-center gap-2 bg-kudu-navy-deep text-[13px] font-bold uppercase tracking-[1.5px] text-white transition-opacity hover:opacity-80">
  Subscribe to our newsletter <Icon name="arrow-right" size={16} />
</a>

<!-- PRODUCT INSPIRATIONS -->
<section data-kudu-inspo class="relative h-[60vh] min-h-[440px] w-full overflow-hidden bg-kudu-navy md:h-[738px]">
  {scenes.map((scene) => (
    <div data-scene class="absolute inset-0 opacity-0 transition-opacity duration-500">
      <img src={img(scene.img)} alt="Kudu Living interior" class="h-full w-full object-cover">
      {scene.spots.map(([x, y, name, category, productImg]) => (
        <div class="absolute" style={`left:${x}%;top:${y}%`}>
          <button data-hotspot type="button" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/85 text-kudu-navy shadow animate-[bb-hotspot-pulse_2.5s_ease-out_infinite] lg:h-[34px] lg:w-[34px]" aria-label={name}><Icon name="plus" size={18} /></button>
          <div data-popup class="fixed inset-x-4 bottom-4 z-[60] hidden bg-white text-left shadow-xl sm:absolute sm:inset-x-auto sm:bottom-auto sm:left-1/2 sm:top-[40px] sm:z-auto sm:w-[240px] sm:-translate-x-1/2">
            <img src={img(productImg)} alt={name} class="h-[160px] w-full object-cover sm:h-[140px]">
            <div class="p-4">
              <div class="text-[11px] uppercase tracking-[1px] text-kudu-muted">{category}</div>
              <div class="font-serif text-[18px] text-kudu-navy">{name}</div>
              <a href={featuredProductUrl} class="mt-2 inline-flex items-center gap-1 py-2 text-[12px] font-bold sm:py-0 sm:text-[11px] uppercase tracking-[1px] text-kudu-navy hover:text-kudu-teal">Discover <Icon name="arrow-right" size={14} /></a>
            </div>
          </div>
        </div>
      ))}
    </div>
  ))}
  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 bg-gradient-to-b from-black/40 to-transparent pb-16 pt-16">
    <div class="mx-auto w-full max-w-[1440px] px-5 md:px-[68px]">
      <h2 class="font-serif text-[24px] text-white md:text-[40px]">Pieces in their place</h2>
    </div>
  </div>
  <button data-inspo-prev type="button" class="absolute left-3 top-1/2 z-20 flex h-[44px] w-[44px] -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-kudu-navy shadow hover:bg-white md:left-6 md:h-[56px] md:w-[56px]" aria-label="Previous"><Icon name="chevron-left" size={22} /></button>
  <button data-inspo-next type="button" class="absolute right-3 top-1/2 z-20 flex h-[44px] w-[44px] -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-kudu-navy shadow hover:bg-white md:right-6 md:h-[56px] md:w-[56px]" aria-label="Next"><Icon name="chevron-right" size={22} /></button>
</section>

<!-- COLLECTIONS (Indoor / Outdoor tiles) -->
<section class="bg-kudu-sand-soft py-[40px] md:py-[60px]">
  <div class="mx-auto grid w-full max-w-[1440px] grid-cols-1 gap-5 px-5 md:grid-cols-2 md:px-[68px]">
    {tiles.map((t) => (
      <a href="/collections/" class="group relative block aspect-[4/4] overflow-hidden md:aspect-[4/5]">
        <img src={img(t.img)} alt={t.label} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[600ms] group-hover:scale-105">
        <div class="absolute inset-0 bg-gradient-to-t from-black/45 to-transparent"></div>
        <div class="absolute bottom-6 left-6 text-white md:bottom-9 md:left-9">
          <div class="font-serif text-[40px] leading-none">{t.label}</div>
          <div class="mt-3 inline-flex items-center gap-2 text-[12px] font-bold uppercase tracking-[1px]">{t.cta} <Icon name="arrow-right" size={16} /></div>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- BESPOKE / DESIGN SERVICE -->
<section class="bg-kudu-bg py-[40px]">
  <div class="mx-auto grid w-full max-w-[1440px] grid-cols-1 items-center gap-10 px-5 md:px-[68px] lg:grid-cols-2">
    <div>
      <p class="text-[12px] font-bold uppercase tracking-[0.12em] text-kudu-teal">Design Service</p>
      <h2 class="mt-5 font-serif text-[30px] leading-[1.1] text-kudu-navy md:text-[34px]">Ready to redefine the way you live?</h2>
      <p class="mt-6 max-w-[52ch] text-[15px] leading-relaxed text-kudu-muted">Our design team helps you shape spaces with natural materials and quiet, considered detailing — a bespoke, one-to-one consultation, in the showroom or at your project, from a single piece to a full interior.</p>
      <a href="/contact/" class="mt-8 inline-flex h-[50px] items-center rounded-none bg-kudu-navy px-9 text-[12px] font-bold uppercase tracking-[1px] text-white transition-colors hover:bg-kudu-navy-deep">Book an appointment</a>
    </div>
    <div>
      <img src={img("sections/design-service.jpg")} alt="Kudu Living design service" class="h-auto w-full object-contain">
    </div>
  </div>
</section>

<!-- CONTRACT BANNER -->
<section class="relative h-[480px] min-h-[420px] w-full overflow-hidden md:h-[592px]">
  <img src={img("sections/contract.jpg")} alt="Kudu Living contract project" class="absolute inset-0 h-full w-full object-cover">
  <div class="absolute inset-0 bg-gradient-to-r from-black/40 to-transparent"></div>
  <div class="absolute bottom-[60px] left-0 w-full md:bottom-[110px]">
    <div class="mx-auto w-full max-w-[1440px] px-5 md:px-[68px]">
      <p class="mb-3 text-[12px] font-bold uppercase tracking-[0.12em] text-white">Projects</p>
      <h2 class="max-w-[16ch] font-serif text-[32px] leading-[1.1] text-white md:text-[46px]">Interiors for homes, hotels &amp; workplaces</h2>
      <a href="/contract/" class="mt-7 inline-flex h-[50px] items-center rounded-none border border-white/90 px-9 text-[12px] font-bold uppercase tracking-[1px] text-white transition-colors hover:bg-white hover:text-kudu-navy">Explore contract</a>
    </div>
  </div>
</section>

<!-- NEWSLETTER CTA -->
<section class="bg-kudu-indigo py-[46px] text-white">
  <div class="mx-auto flex w-full max-w-[1440px] flex-col gap-6 px-5 md:flex-row md:items-center md:justify-between md:px-[68px]">
    <div>
      <h3 class="font-serif text-[30px] leading-tight text-white">Join the Kudu Living world</h3>
      <p class="mt-2 max-w-[46ch] text-[14px] text-white/85">New collections, stories of craft and showroom invitations — straight to your inbox.</p>
    </div>
    <a href="/contact/" class="inline-flex h-[50px] w-max items-center rounded-none bg-kudu-teal px-9 text-[12px] font-bold uppercase tracking-[1px] text-kudu-navy transition-colors hover:bg-white">Subscribe now</a>
  </div>
</section>

</main>
</Base>
