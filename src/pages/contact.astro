---
/* Contact — navy hero, enquiry form (sent via /api/contact → Resend), showroom info, closing band. */
import Base from "../layouts/Base.astro";

const container = "mx-auto w-full max-w-[1440px] px-5 md:px-[68px]";
const field = "w-full border border-kudu-line px-4 py-3 text-[16px] text-kudu-navy outline-none lg:text-[15px] transition-colors focus:border-kudu-navy";
const label = "mb-2 block text-[12px] font-bold uppercase tracking-[0.12em] text-kudu-muted";

const info = [
  { label: "Showroom", lines: ["Kudu Living Studio", "14 Riverside Walk", "Cape Town, 8001"] },
  { label: "Opening hours", lines: ["Mon – Fri, 9am – 6pm", "Saturday, 10am – 4pm", "Sunday by appointment"] },
  { label: "Email", lines: ["hello@kuduliving.com"] },
  { label: "Phone", lines: ["+27 21 000 0000"] },
  { label: "Trade enquiries", lines: ["trade@kuduliving.com", "For interior designers, architects & contract projects."] },
];

const interests = ["General enquiry", "Bespoke project", "Trade & contract", "Showroom visit"];
---
<Base title="Contact">
<main>

<!-- PAGE HERO -->
<section class="relative bg-kudu-navy pt-[112px] pb-[48px] text-white md:pt-[150px] md:pb-[70px]">
  <div class={container}>
    <nav class="mb-5 text-[12px] uppercase tracking-[0.14em] text-kudu-teal" aria-label="Breadcrumb">
      <a href="/" class="-my-3 inline-block py-3 transition-opacity hover:opacity-80">Home</a>
      <span class="mx-2 text-white/40">|</span>
      <span class="text-white/80">Contact</span>
    </nav>
    <h1 class="max-w-[16ch] font-serif text-[38px] leading-[1.05] md:text-[44px]">Get in touch</h1>
    <p class="mt-6 max-w-[54ch] text-[16px] leading-relaxed text-white/80">Whether you are planning a single piece or a full interior, our team would love to hear from you. Send us a note and we will be in touch — or visit the showroom to experience the collection in person.</p>
  </div>
</section>

<!-- BODY: FORM + CONTACT INFO -->
<section class="bg-white py-[48px] md:py-[70px]">
  <div class={container}>
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">

      <!-- LEFT: enquiry form -->
      <div>
        <h2 class="font-serif text-[28px] leading-tight text-kudu-navy">Send us a message</h2>
        <p class="mt-3 max-w-[48ch] text-[15px] leading-relaxed text-kudu-muted">Tell us a little about your project and we will point you to the right person.</p>

        <form data-contact-form action="/api/contact/" method="post" class="mt-8 space-y-6">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="kudu-first-name" class={label}>First name</label>
              <input type="text" id="kudu-first-name" name="first_name" autocomplete="given-name" required class={field}>
            </div>
            <div>
              <label for="kudu-last-name" class={label}>Last name</label>
              <input type="text" id="kudu-last-name" name="last_name" autocomplete="family-name" class={field}>
            </div>
          </div>

          <div>
            <label for="kudu-email" class={label}>Email</label>
            <input type="email" id="kudu-email" name="email" autocomplete="email" required class={field}>
          </div>

          <div>
            <label for="kudu-interest" class={label}>I'm interested in</label>
            <select id="kudu-interest" name="interest" class={`${field} bg-white`}>
              {interests.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>

          <div>
            <label for="kudu-message" class={label}>Message</label>
            <textarea id="kudu-message" name="message" rows="6" required class={`${field} resize-y`}></textarea>
          </div>

          <!-- Spam trap: hidden from people, filled in by bots. -->
          <div class="screen-reader-text" aria-hidden="true">
            <label for="kudu-company">Company</label>
            <input type="text" id="kudu-company" name="company" tabindex="-1" autocomplete="off">
          </div>

          <!-- Send result; stays hidden until a submission returns. The button stays last so spacing is unchanged. -->
          <p data-contact-status role="status" class="hidden text-[15px] leading-relaxed text-kudu-navy"></p>

          <button type="submit" class="inline-flex h-[50px] w-full items-center justify-center rounded-none sm:w-auto sm:justify-start bg-kudu-navy px-9 text-[12px] font-bold uppercase tracking-[1px] text-white transition-colors hover:bg-kudu-navy-deep">Send enquiry</button>
        </form>
      </div>

      <!-- RIGHT: contact / showroom info -->
      <aside class="lg:pl-6">
        <div class="space-y-7">
          {info.map((item) => (
            <div>
              <div class="text-[12px] uppercase tracking-[0.14em] text-kudu-teal">{item.label}</div>
              <div class="mt-2 space-y-1 text-[15px] leading-relaxed text-kudu-navy">
                {item.lines.map((line) => <p>{line}</p>)}
              </div>
            </div>
          ))}
        </div>
      </aside>

    </div>
  </div>
</section>

<!-- CLOSING BAND -->
<section class="bg-kudu-indigo py-[46px] text-white">
  <div class={container}>
    <p class="text-center font-serif text-[30px] leading-tight">Rooted in Nature.</p>
  </div>
</section>

</main>

<script is:inline>
  // Submit the enquiry without leaving the page; falls back to a normal POST without JS.
  (function () {
    var form = document.querySelector("[data-contact-form]");
    if (!form) return;
    var status = form.querySelector("[data-contact-status]");
    var button = form.querySelector('button[type="submit"]');
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      button.disabled = true;
      fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (r) {
          status.textContent = r.data.message;
          if (r.ok) form.reset();
        })
        .catch(function () {
          status.textContent = "Sorry, your message could not be sent. Please email hello@kuduliving.com.";
        })
        .finally(function () {
          status.classList.remove("hidden");
          button.disabled = false;
        });
    });
  })();
</script>
</Base>
