---
/* Catalogue library — grid of downloadable catalogue covers. */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { img } from "../lib/content";

const container = "mx-auto w-full max-w-[1440px] px-5 md:px-[68px]";

// Set `pdf` to a file URL (e.g. /catalogues/indoor-2026.pdf in public/) once catalogues exist.
const catalogues = [
  { title: "Indoor 2026", cover: "categories/indoor.jpg", pdf: "#" },
  { title: "Outdoor 2026", cover: "categories/outdoor.jpg", pdf: "#" },
  { title: "Savanna Collection", cover: "inspirations/scene-01.jpg", pdf: "#" },
  { title: "Living & Day Systems", cover: "inspirations/scene-02.jpg", pdf: "#" },
  { title: "Beds & Bedroom", cover: "inspirations/scene-03.jpg", pdf: "#" },
  { title: "Tables & Storage", cover: "inspirations/scene-04.jpg", pdf: "#" },
  { title: "Accessories & Light", cover: "inspirations/scene-05.jpg", pdf: "#" },
  { title: "Contract Projects", cover: "sections/contract.jpg", pdf: "#" },
];
---
<Base title="Catalogues">
<main class="bg-white pt-[72px] text-kudu-navy md:pt-[100px]">
  <div class={`${container} py-[36px] md:py-[50px]`}>

    <h1 class="font-serif text-[32px] leading-tight text-kudu-navy md:text-[36px]">Catalogues</h1>
    <p class="mt-3 max-w-[640px] text-[16px] text-kudu-muted">
      Browse and download the latest Kudu Living catalogues — collections, contract work
      and inspiration, ready to keep.
    </p>

    <div class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
      {catalogues.map((catalogue) => (
        <div class="flex flex-col">
          <div class="aspect-[3/4] w-full overflow-hidden bg-kudu-sand-soft">
            <img src={img(catalogue.cover)} alt={catalogue.title} class="h-full w-full object-cover">
          </div>
          <h2 class="mt-4 font-serif text-[18px] leading-snug text-kudu-navy">
            {catalogue.title}
          </h2>
          <a
            href={catalogue.pdf}
            class="inline-flex items-center gap-2 py-3 text-[12px] md:mt-2 lg:py-0 font-bold uppercase tracking-[0.08em] text-kudu-teal hover:text-kudu-navy"
          >
            Download PDF
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      ))}
    </div>

  </div>
</main>
</Base>
