---
/* Inspiration — dark quote hero, static filter chips, two-column grid of the first six projects. */
import Base from "../layouts/Base.astro";
import { projects } from "../lib/content";

const filters = ["ALL", "RESIDENTIAL", "HOSPITALITY", "WORKPLACE"];
const cards = projects.slice(0, 6);
---
<Base title="Inspiration">
<main class="bg-kudu-bg text-kudu-navy">

  <!-- DARK QUOTE HERO -->
  <section class="relative flex w-full flex-col overflow-hidden bg-kudu-navy text-white md:h-[430px] md:items-center md:justify-center">
    <!-- Breadcrumb top-left (content sits under the fixed 100px header) -->
    <div class="w-full md:absolute md:left-0 md:top-0">
      <div class="mx-auto w-full max-w-[1440px] px-5 pt-[96px] md:px-[68px] md:pt-[110px]">
        <p class="text-[13px] text-white/70">Home | Inspiration</p>
      </div>
    </div>

    <!-- Centered quote -->
    <div class="px-5 py-12 text-center md:py-0">
      <p class="font-serif text-[30px] font-bold leading-tight text-white/90 md:text-[40px]">
        Furniture shapes how people
        <br class="hidden md:inline" />
        live, feel and connect.
      </p>
      <p class="mt-4 text-[20px] font-serif text-white/70 md:mt-6 md:text-[22px]">
        Kudu Living
      </p>
    </div>

    <!-- Bottom-left overlay -->
    <div class="w-full md:absolute md:bottom-0 md:left-0">
      <div class="mx-auto w-full max-w-[1440px] px-5 pb-10 md:px-[68px]">
        <p class="text-[12px] font-bold uppercase tracking-[0.12em] text-kudu-teal">
          Inspiration
        </p>
        <h2 class="mt-3 font-serif text-[26px] font-bold text-white md:text-[30px]">
          Pieces in their place
        </h2>
        <a
          href="/inspiration/"
          class="mt-5 inline-flex h-[50px] items-center rounded-none border border-white/90 bg-transparent px-9 text-[12px] font-bold uppercase tracking-[1px] text-white transition-colors hover:bg-white hover:text-kudu-navy"
        >
          Discover Now
        </a>
      </div>
    </div>
  </section>

  <!-- FILTER TABS (static chips, first active) -->
  <div class="overflow-x-auto border-b border-kudu-navy/10 bg-kudu-bg py-[24px]">
    <div class="mx-auto flex w-max items-center gap-6 px-5 md:w-auto md:justify-center md:gap-10 md:px-0">
      {filters.map((filter, i) => (
        <span
          class={`${i === 0
            ? "border-b-2 border-kudu-navy pb-1 font-bold text-kudu-navy"
            : "font-normal text-kudu-muted transition-colors hover:text-kudu-navy"} whitespace-nowrap text-[13px] uppercase tracking-[0.5px] md:text-[14px]`}
        >
          {filter}
        </span>
      ))}
    </div>
  </div>

  <!-- EDITORIAL GRID (2-col) -->
  <div class="mx-auto w-full max-w-[1440px] px-5 py-[40px] md:px-[68px]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-6">
      {cards.map((p) => (
        <a href={`/project/${p.slug}/`} class="group block cursor-pointer">
          <div class="overflow-hidden">
            <img
              src={p.image}
              alt={p.title}
              class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            >
          </div>
          <p class="mt-4 text-[12px] font-bold uppercase tracking-[0.12em] text-kudu-muted">
            {p.category}
          </p>
          <h3 class="mt-2 font-serif text-[22px] font-bold text-kudu-navy">
            {p.title}
          </h3>
        </a>
      ))}
    </div>
  </div>

</main>
</Base>
