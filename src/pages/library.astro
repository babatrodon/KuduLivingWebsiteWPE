---
/* Resource library — grid of downloadable technical resources for professionals. */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

const container = "mx-auto w-full max-w-[1440px] px-5 md:px-[68px]";

const resources = [
  { title: "Product datasheets", description: "Detailed technical specifications for every piece in the collection." },
  { title: "2D / 3D files", description: "CAD drawings and 3D models ready to drop straight into your project." },
  { title: "Care & maintenance", description: "Guidance on cleaning, upkeep and preserving each material over time." },
  { title: "Certifications", description: "Fire, environmental and quality certifications for contract use." },
  { title: "Material samples", description: "Request fabric, leather and timber swatches delivered to your studio." },
  { title: "BIM objects", description: "Parametric BIM components for Revit and ArchiCAD workflows." },
];
---
<Base title="Library">
<main class="bg-white pt-[72px] text-kudu-navy md:pt-[100px]">
  <div class={`${container} py-[36px] md:py-[50px]`}>

    <h1 class="font-serif text-[32px] leading-tight text-kudu-navy md:text-[36px]">Library</h1>
    <p class="mt-3 max-w-[640px] text-[16px] text-kudu-muted">
      Technical resources, certifications and 3D models for architects, designers and
      specifiers working with Kudu Living.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {resources.map((resource) => (
        <div class="flex flex-col border border-kudu-line bg-white p-6 shadow md:p-8">
          <h2 class="font-serif text-[18px] leading-snug text-kudu-navy">
            {resource.title}
          </h2>
          <p class="mt-3 flex-1 text-[14px] leading-relaxed text-kudu-muted">
            {resource.description}
          </p>
          <a
            href="#"
            class="mt-3 inline-flex items-center gap-2 py-3 text-[12px] md:mt-6 lg:py-0 font-bold uppercase tracking-[0.08em] text-kudu-teal hover:text-kudu-navy"
          >
            Download
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      ))}
    </div>

  </div>
</main>
</Base>
